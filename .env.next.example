# Config for the "next" stack (compose.next.yml). Copy to .env.next and use:
#   docker compose -f compose.next.yml --env-file .env.next ...
# Every variable is optional; defaults shown.

# --- image build (Dockerfile.next) -----------------------------------------
# What to install. Newest PyPI release by default. Examples:
#   mcp-proxy==0.15.0
#   git+https://github.com/sparfenyuk/mcp-proxy@main
#MCP_PROXY_SPEC=mcp-proxy
# Force the mcp SDK version (overrides mcp-proxy's own "mcp<2" cap).
# Leave empty until mcp-proxy supports mcp 2; up to mcp-proxy 0.15.0 (Nov 2026)
# "mcp>=2" fails the build's smoke test because mcp 2 removed request_ctx.
#MCP_SPEC=mcp>=2
#UV_VERSION=latest
#PYTHON_VERSION=3.12

# --- compose ---------------------------------------------------------------
#MCP_PROXY_CONTAINER_NAME=mcp-proxy-next
# Different from the stable stack (8005) so both can run at once.
MCP_PROXY_PUBLISHED_PORT=8006
# Separate servers.json from the stable stack.
#MCP_CONFIG_DIR=./data/mcp-next

# --- mcp-proxy flags (same as .env.example) --------------------------------
MCP_PROXY_ALLOWED_HOSTS=192.168.111.111:*,mcp-proxy-next:*
MCP_PROXY_ALLOW_ORIGINS=*
#MCP_PROXY_PASS_ENV=false
#MCP_PROXY_LOG_LEVEL=
#MCP_PROXY_DEBUG=false
# Newer mcp-proxy versions may add flags; pass them here.
#MCP_PROXY_EXTRA_ARGS=

# --- admin page (mcp-manager) ----------------------------------------------
# true: servers are managed from the admin page and stored one file each in
# <MCP_CONFIG_DIR>/servers.d/ (an existing servers.json is imported once).
# Every server is supervised. Admin page: http://<host>:<MCP_MANAGER_PUBLISHED_PORT>
MCP_MANAGER=true
MCP_MANAGER_PUBLISHED_PORT=8016
# Login: user "admin". Empty = generated on first start, printed in the log
# and stored in <MCP_CONFIG_DIR>/manager.password.
#MCP_MANAGER_PASSWORD=

# --- per-server supervision (mcp-supervise) --------------------------------
# true: wrap every server. Only that server is restarted when it crashes,
# instead of mcp-proxy shutting down with all of them. Per server, a
# "supervise" key in servers.json overrides these defaults or opts out
# ("supervise": false).
MCP_SUPERVISE=true
# Restart a server when it is idle and its RSS (whole process tree) is above this.
#MCP_SUPERVISE_MAX_RSS=800M
# Restart immediately above this, even mid-request (that request gets an error).
#MCP_SUPERVISE_HARD_RSS=2G
# Restart an idle server after it has run this long (clears slow leaks).
#MCP_SUPERVISE_MAX_AGE=24h
# Stop a server unused for this long; it starts again on the next request.
#MCP_SUPERVISE_IDLE_STOP=2h
# Log every server's RSS this often (default 1h) - useful for choosing limits.
#MCP_SUPERVISE_LOG_INTERVAL=1h
