# Copy to .env and adjust. Every variable is optional; defaults shown.

# --- compose ---------------------------------------------------------------
# Container name.
#MCP_PROXY_CONTAINER_NAME=mcp-proxy
# Host port published to the container port (MCP_PROXY_PORT).
MCP_PROXY_PUBLISHED_PORT=8005
# Host directory mounted at /mcp (must contain servers.json).
#MCP_CONFIG_DIR=./data/mcp

# --- mcp-proxy flags (translated by entrypoint.sh) -------------------------
# --host: bind address inside the container.
#MCP_PROXY_HOST=0.0.0.0
# --port: listen port inside the container.
#MCP_PROXY_PORT=8000
# --transport: sse | streamablehttp. (mcp-proxy documents this as a client-mode
# option; in server mode both /sse and /mcp endpoints are served.)
#MCP_PROXY_TRANSPORT=streamablehttp
# --named-server-config: path inside the container.
#MCP_PROXY_CONFIG=/mcp/servers.json
# Comma-separated -> repeated --allowed-host. Needed for any non-loopback Host
# header (LAN IP, container name), otherwise HTTP 421 "Invalid Host header".
# Supports wildcard port "host:*".
MCP_PROXY_ALLOWED_HOSTS=192.168.111.111:*,proxy-mcp:*
# Comma-separated -> repeated --allow-origin (CORS).
MCP_PROXY_ALLOW_ORIGINS=*
# true -> --pass-environment: stdio servers inherit the container environment.
#MCP_PROXY_PASS_ENV=false
# --log-level, e.g. DEBUG, INFO, WARNING. Empty = mcp-proxy default (INFO).
#MCP_PROXY_LOG_LEVEL=
# true -> --debug.
#MCP_PROXY_DEBUG=false
# Raw extra flags, whitespace-split, e.g. "--stateless --initialization-timeout 60".
#MCP_PROXY_EXTRA_ARGS=

# --- auth ------------------------------------------------------------------
# mcp-proxy has NO inbound authentication in server mode. (API_ACCESS_TOKEN is
# only used in client mode for outgoing requests.) Restrict access with your
# firewall / Docker network, or put an authenticating reverse proxy in front.
