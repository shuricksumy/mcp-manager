{
  "mcpServers": {
    "music-assistant": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "--from",
        "git+https://github.com/shuricksumy/MCP-MusicAssistant@v1",
        "music-assistant-mcp"
      ],
      "env": {
        "MA_SERVER_URL": "http://192.168.1.50:8095",
        "MA_TOKEN": "<music-assistant-long-lived-token>",
        "MCP_TRANSPORT": "stdio",
        "DEFAULT_PLAYER_NAME": "Living Room",
        "SOURCE_PRIORITY": "tidal,spotify,apple_music"
      }
    },
    "frigate": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "--from",
        "git+https://github.com/jakekeeys/frigate-mcp",
        "frigate-mcp"
      ],
      "env": {
        "FRIGATE_URL": "http://192.168.1.60:5000"
      },
      "supervise": {
        "maxRss": "500M",
        "hardRss": "1G"
      }
    },
    "qdrant": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2.0.0",
        "mcp-server-qdrant"
      ],
      "env": {
        "QDRANT_URL": "http://qdrant:6333",
        "COLLECTION_NAME": "recipes"
      },
      "supervise": {
        "maxRss": "1G",
        "hardRss": "2G",
        "idleStop": "2h"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/data/recipe-archive/recipes"
      ]
    },
    "finance-fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/data/finance"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "supervise": {
        "maxAge": "24h",
        "logInterval": "15m"
      }
    },
    "mcp-time": {
      "command": "npx",
      "args": [
        "-y",
        "@theo.foobar/mcp-time"
      ],
      "supervise": false
    },
    "searxng": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://searxng:8080"
      }
    },
    "disabled-example": {
      "enabled": false,
      "command": "uvx",
      "args": [
        "some-mcp-server"
      ]
    }
  }
}
